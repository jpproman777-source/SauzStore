{
  "name": "tienda-express",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda Express - Carrito de compras (Frontend + Backend)",
  "scripts": {
    "start": "node backend/server.js",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:backend": "node backend/server.js",
    "start:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": ["shopping-cart", "ecommerce", "vanilla-js", "node"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}

